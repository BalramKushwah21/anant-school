// ==========================================
// 1. CLIENT & DATABASE CONFIGURATION
// ==========================================
datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}




// ==========================================
// 1. ADMIN PROFILE MODEL
// ==========================================
model AdminProfile {
  id              String   @id @default(cuid())
  profilePhoto    String?  @db.Text  // Text type for long image URLs/Base64
  
  // Personal Information
  firstName       String
  lastName        String?
  gender          Gender?
  dob             DateTime? @db.Date
  bloodGroup      String?   // Can be Enum: A+, O-, etc.
  maritalStatus   MaritalStatus?

  // Contact & Address
  mobileNumber    String
  alternateMobile String?
  address         String?
  city            String?
  state           String?
  pincode         String?

  // Professional Specs
  designation     String?   // e.g., "Principal & Chief Administrator"
  department      String?   // e.g., "Institutional Operations"
  qualification   String?
  experience      String?
  specialization  String?
  status          AdminStatus @default(ACTIVE)

  // ----------------------------------------
  // RELATIONS & SAAS MULTI-TENANCY
  // ----------------------------------------
  
  // Link to User table (1-to-1 relation for authentication)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Link to School table (Multi-tenancy isolation)
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Indexes for fast querying in large SaaS DB
  @@index([schoolId])


}

// ==========================================
// 2. SYSTEM & MULTI-TENANCY (SAAS CORE)
// ==========================================


model School {
  id               String   @id @default(cuid())
  schoolName       String
  subdomain        String   @unique
  schoolType       String   // e.g., Primary, Secondary, K-12
  adminName        String?
  udiseCode        String   @unique
  phone            String
  email            String   @unique
  city             String
  district         String
  state            String
  address          String
  pincode          String
  logo             String?
  subscriptionPlan String   @default("BASIC")
  isActive         Boolean  @default(true)

  // Relationships (One School -> Many Entities)
  teacherAttendances TeacherAttendance[]
  academicYears    AcademicYear[] 
  users            User[]
  teachers         Teacher[]
  students         Student[]
  families         Family[] 
  academicProfiles AcademicProfile[]
  medicalProfiles  MedicalProfile[]
  feeRecords       FeeRecord[]
  transportProfiles TransportProfile[]
  documentArchives DocumentArchive[]
  attendances      Attendance[]
  feeStructures    FeeStructure[]
  examResults      ExamResult[]
  vehicles         Vehicle[]
  adminProfiles   AdminProfile[]



  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// 3. ACADEMIC YEAR (TEMPORAL ISOLATION)
// ==========================================

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   // e.g., "2024-25"
  isActive  Boolean  @default(false) 
  
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  attendances      Attendance[]
  feeRecords       FeeRecord[]
  academicProfiles AcademicProfile[]
  examResults      ExamResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, year])
  @@index([schoolId])
}

// ==========================================
// 4. USERS & ROLES
// ==========================================

model User {
  id        String   @id @default(cuid())
  name      String
  userRole  UserRole
  username  String?  @unique
  email     String?   @unique
  password  String
  isActive  Boolean  @default(true)

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherProfile Teacher?
  adminProfile    AdminProfile?




  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([email])
}

model Teacher {
  id               String   @id @default(cuid())
  
  schoolId         String 
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal Details
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           Gender
  email            String   @unique
  phone            String
  address          String?
  nationalIdNumber String?  @unique 

  // Professional Details
  employeeId       String
  designation      String
  department       String
  dateOfJoining    DateTime
  qualification    String
  experienceYears  Int      @default(0)
  isClassTeacher   Boolean  @default(false)
  status           String   @default("Active")

  // Payroll & Bank Details
  basicSalary      Decimal  @default(0.00) @db.Decimal(10, 2)
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  panNumber        String?
  profilePhoto     String?

  attendances  TeacherAttendance[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([schoolId, employeeId]) 
  @@index([schoolId])
}

// ==========================================
// TEACHER ATTENDANCE
// ==========================================

model TeacherAttendance {
  id          String   @id @default(cuid()) 
  schoolId    String   
  teacherId   String   
  date        DateTime @db.Date 
  status      String   
  remarks     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, date])
  @@index([schoolId, date])
}

// ==========================================
// 5. FAMILY & PARENT DYNAMICS
// ==========================================

model Family {
  id                   String @id @default(cuid())
  schoolId             String
  school               School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  parentsMaritalStatus MaritalStatus @default(MARRIED)
  legalCustodyHolder   Custody       @default(BOTH)

  fatherName           String
  fatherMobile         String
  fatherOccupation     String?
  fatherIncome         String?
  fatherEmail          String?
  fatherDOB            String?
  motherName           String
  motherMobile         String?
  motherOccupation     String?
  motherEmail          String?
  motherDOB            String?
  siblingStudyingHere  Boolean @default(false)
  siblingDetails       String?
  address              Address?
  students             Student[] 

  createdAt            DateTime @default(now())

  @@index([schoolId])
}

model Address {
  id       String @id @default(cuid())
  familyId String @unique
  studentId  String  @unique
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  houseNo  String?
  street   String
  city     String
  district String
  state    String
  pincode  String
}

// ==========================================
// 6. STUDENT CORE
// ==========================================

model Student {
  id                 String @id @default(cuid())

  schoolId           String
  school             School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  familyId           String
  family             Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId             String?  @unique
  rollNumber         String?
  firstName          String
  middleName         String?
  lastName           String
  studentEmail       String? @unique

  admissionDate      DateTime
  gender             Gender
  dateOfBirth        DateTime
  bloodGroup         String?
  religion           String?
  category           Category
  nationality        String   @default("Indian")
  isStaffChild       Boolean  @default(false)
  identificationMark String?
  aadharNumber      String?  @unique 
  abcId              String?
  panNumber          String?
  samagraId          String? @unique

  medicalProfile     MedicalProfile?
  transportProfile   TransportProfile?
  documents          DocumentArchive?
  
  academicProfiles   AcademicProfile[]
  feeRecords         FeeRecord[]
  attendances        Attendance[]
  addresses          Address[]
  examResults       ExamResult[]


  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([schoolId, rollNumber])
  @@index([schoolId])
}

// ==========================================
// 7. TEMPORAL STUDENT PROFILES
// ==========================================

model AcademicProfile {
  id                   String  @id @default(cuid())
  schoolId             String
  school               School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  studentId            String  
  student              Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId       String
  academicYear         AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  academicSession      String?
  currentClass         String
  section              String?
  udiseNumber          String?
  
  previousSchool       String?
  previousClass        String?
  previousUdiseCode    String?
  previousSchoolMedium String?
  tcNumber             String?
  boardRegistrationNo  String?


  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([studentId, academicYearId]) 
  @@index([schoolId, academicYearId]) 
}

model FeeStructure {
  id           Int      @id @default(autoincrement())
  className    String   @unique
  academicYear String
  
  tuitionFee   Float    @default(0)
  libraryFee   Float    @default(0)
  transportFee Float    @default(0)
  activityFee  Float    @default(0)
  totalFee    Float    @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Multi-tenant relationship (Uncommented and linked)
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}


model FeeRecord {
  id                  String       @id @default(cuid())
  schoolId            String
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  studentId            String       
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId      String
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  feeCategory         FeeCategory  @default(GENERAL)
  scholarship         Boolean      @default(false)
  concessionDetails   String?      @db.Text

  admissionFeePaid    Decimal      @default(0.00) @db.Decimal(10, 2)
  transportFeePaid    Decimal?     @default(0.00) @db.Decimal(10, 2)
  securityDepositPaid Decimal?     @default(0.00) @db.Decimal(10, 2)
  
  tuitionFeeCycle     TuitionCycle @default(QUARTERLY)
  paymentMode         PaymentMode  @default(CASH)

  bankName            String?
  accountNumber       String?
  ifscCode            String?
  branchNameAndCode   String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([schoolId, academicYearId])
  @@index([studentId])
}

model Attendance {
  id             String       @id @default(cuid())
  date           DateTime     @db.Date 
  status         String       
  remarks        String?
  studentId      String
  schoolId       String
  academicYearId String

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, academicYearId, date])
}

// ==========================================
// 8. STATIC STUDENT PROFILES
// ==========================================

model MedicalProfile {
  id                        String  @id @default(cuid())
  schoolId                  String
  school                    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId                 String  @unique 
  student                   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  emergencyContactName      String
  emergencyContactNumber    String
  relationWithStudent       String
  familyDoctorName          String?
  familyDoctorContactNumber String?
  preferredHospital         String?
  medicalConditions         String?  @db.Text
  allergies                 String?

  @@index([schoolId])
}

model TransportProfile {
  id            String  @id @default(cuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String  @unique
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  needTransport Boolean @default(false)
  pickupPoint   String?
  route         String?

  @@index([schoolId])
}

model DocumentArchive {
  id                     String  @id @default(cuid())
  schoolId               String
  school                 School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId              String  @unique
  student                Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentPhotoUrl        String?
  birthCertificateUrl    String?
  idCardCopyUrl          String? 
  previousMarksheetUrl   String?
  transferCertificateUrl String? 
  parentIdCopyUrl        String?

  @@index([schoolId])
}

// ==========================================
// TRANSPORT & FLEET MANAGEMENT
// ==========================================

model Vehicle {
  id                String   @id @default(cuid())
  
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  vehicleNumber     String   // e.g., MH-04-AB-1234
  vehicleType       String   @default("Bus") // Bus, Mini-Van, Traveler
  capacity          Int      @default(40)
  
  driverName        String?
  driverContact     String?
  
  insuranceExpiry   DateTime? @db.Date
  fitnessExpiry     DateTime? @db.Date
  
  status            String   @default("Active") // Active, Maintenance, Inactive

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([schoolId, vehicleNumber])
  @@index([schoolId])
}





// ==========================================
// 10. EXAM & MARKSHEET MODULE
// ==========================================

model ExamResult {
  id              String        @id @default(cuid())

  // --- SaaS & Temporal Relations ---
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  // --- Exam Metadata ---
  examTerm        String        // e.g., "Term 1", "Half Yearly", "Annual"
  
  // --- Overall Summary ---
  totalMaxMarks   Float?        
  totalObtained   Float?        
  percentage      Float?        
  overallGrade    String?       
  resultStatus    String?       // e.g., "Pass", "Fail", "Compartment", "Promoted"
  overallRemarks  String?
  
  // --- Relation to subject-wise marks ---
  subjectMarks    SubjectMark[] 

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([studentId, academicYearId, examTerm])
  // Indexes for fast fetching in SaaS dashboard
  @@index([schoolId, academicYearId])
  @@index([studentId])
}

model SubjectMark {
  id                String     @id @default(cuid())
  
  // --- Parent Relation ---
  examResultId      String
  examResult        ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  
  // --- Subject Identity ---
  subjectName       String     // e.g., "Mathematics"
  subjectCode       String?    // e.g., "041"
  subjectType       String?    // e.g., "Scholastic", "Co-Scholastic"
  orderIndex        Int?       // Marksheet me sorting ke liye

  // --- MAXIMUM POSSIBLE SCORE CASES ---
  theoryMax         Float?     
  theoryObtained    Float?     
  theoryPassMark    Float?     

  practicalMax      Float?     
  practicalObtained Float?     
  practicalPassMark Float?     

  internalMax       Float?     
  internalObtained  Float?     

  totalMax          Float?     
  totalObtained     Float?     
  
  grade             String?    
  gradePoint        Float?     

  // --- Edge Cases ---
  isAbsent          Boolean    @default(false)  
  passStatus        String?    
  remarks           String?    

  // --- Custom Fallback for unique school formats ---
  customComponents  Json?      

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([examResultId])
}
// ==========================================
// 9. ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  GENERAL
  OBC
  SC
  ST
}

enum MaritalStatus {
  MARRIED
  SINGLE
  DIVORCED
  WIDOWED
}

enum Custody {
  BOTH
  FATHER
  MOTHER
  GUARDIAN
}

enum FeeCategory {
  GENERAL
  STAFF_DISCOUNT
  SIBLING_DISCOUNT
  EWS
  MERIT
}

enum TuitionCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
}


enum AdminStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}